# ==========================================
# AUTOVERSE ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Use local MongoDB (e.g. mongodb://localhost:27017/autoverse) or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/autoverse

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Dealership Information
DEALERSHIP_CITY=Lucknow
DEALERSHIP_STATE=Uttar Pradesh

# AI Provider Configuration (Options: "gemini" | "openai" | "fallback")
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_TIMEOUT_MS=8000
AI_CONFIDENCE_THRESHOLD=0.70

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Cloudinary (Optional for uploads, local asset fallback active by default)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

